+bool worldBusy() {
+    // A cutscene, a stage change, or a menu over the game.
+    return dComIfGp_event_runCheck() || dComIfGp_isEnableNextStage() || dMenu_flag();
+}
+
+bool riding(int player) {
+    return (play().mPlayerStatus[player][0] & daPyStts0_SHIP_RIDE_e) != 0;
+}
+
+// Player 2's own boat, beside Player 1's whenever Player 1's is out. It is Player 2's like their
+// Link: it runs in their context, so the boat lookups in it, in their Link and in their camera
+// find it, and it goes with them.
+void updatePlayer2Ship() {
+    fopAc_ac_c* p1Ship = play().getShipPhysical(0);
+    const bool p1ShipOut = p1Ship != nullptr && !fpcM_IsCreating(fopAcM_GetID(p1Ship));
+    const bool have = procAlive(s_p2ShipId);
+    if (!p1ShipOut) {
+        // Not from under Player 2.
+        if (have && procCreated(s_p2ShipId) && !riding(1)) {
+            deleteProc(s_p2ShipId);
+            s_p2ShipId = kNoProc;
+            play().mPlayer2ShipPtr = NULL;
+        }
+        return;
+    }
+    if (have) {
+        return;
+    }
+    // Alongside Player 1's, on their right, far enough out that the boats do not touch.
+    const s16 side = p1Ship->shape_angle.y - 0x4000;
+    cXyz pos(p1Ship->current.pos.x + cM_ssin(side) * 650.0f, p1Ship->current.pos.y,
+             p1Ship->current.pos.z + cM_scos(side) * 650.0f);
+    csXyz angle(0, p1Ship->shape_angle.y, 0);
+    pc_ss_scoped_ctx ctx(1, 1);
+    // Room -1, like the Links: the boat is not deleted with a room.
+    s_p2ShipId = fopAcM_create(fpcNm_SHIP_e, fopAcM_GetParam(p1Ship), &pos, -1, &angle);
+    pc::writef(STDERR_FILENO, "[cos] splitscreen: Player 2's boat (%u)\n", s_p2ShipId);
+}
