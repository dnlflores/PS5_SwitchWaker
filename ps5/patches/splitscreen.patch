+    s_bringPlayer1Requested = false;
+    s_owned.clear();
+    s_ownedP1.clear();
+    s_pendingDelete.clear();
+    s_p2LinkId = kNoProc;
+    s_p2CameraId = kNoProc;
+    s_p2ShipId = kNoProc;
+    s_suspended = false;
+    s_respawnRequested = false;
+    s_cooldown = 30;
+    s_separatedFrames = 0;
+    s_p2Attention = nullptr;
+    s_p2AttentionMem = nullptr;
+    play().mpPlayer2Attention = nullptr;
+    play().mPlayer2LinkPtr = nullptr;
+    play().mPlayer2ShipPtr = nullptr;
+    std::memset(play().mPlayerStatus[1], 0, sizeof(play().mPlayerStatus[1]));
+    setupTables();
