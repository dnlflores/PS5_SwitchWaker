+bool pc_ss_block_scene_change() {
+    if (g_pc_ss_ctx.player != s_lead) {
+        (g_pc_ss_ctx.player == 1 ? s_respawnRequested : s_bringPlayer1Requested) = true;
+        return true;
+    }
+    return false;
+}
+
+bool pc_ss_block_global_change() {
+    return g_pc_ss_ctx.player != s_lead;
+}
+
+bool pc_ss_block_event_order(uint16_t type) {
+    if (g_pc_ss_ctx.player == s_lead || s_curOwner < 0) {
+        return false;
+    }
+    // A player's own interaction (talking, a door, a chest, an item) makes them the lead; anything
+    // else they would start is left to the lead.
+    switch (type) {
+    case dEvtType_TALK_e:
+    case dEvtType_DOOR_e:
+    case dEvtType_ITEM_e:
+    case dEvtType_SHOWITEM_X_e:
+    case dEvtType_SHOWITEM_Y_e:
+    case dEvtType_SHOWITEM_Z_e:
+    case dEvtType_CATCH_e:
+    case dEvtType_TREASURE_e:
+        if (!dComIfGp_event_runCheck() && play().getEvent()->mOrderCount == 0) {
+            setLead(g_pc_ss_ctx.player, "interaction");
+            return false;
+        }
+        return true;
+    default:
+        return true;
+    }
+}
+
+bool pc_ss_drops_damage() {
+    return s_curOwner == 1;
+}
+
+int pc_ss_lead() {
+    return s_lead;
+}
diff --git a/native/src/pc/game_hooks/pc_splitscreen_tunic.cpp b/native/src/pc/game_hooks/pc_splitscreen_tunic.cpp
new file mode 100644
index 0000000..775f987
--- /dev/null
+++ b/native/src/pc/game_hooks/pc_splitscreen_tunic.cpp
@@ -0,0 +1,515 @@
+// Split-screen: a tunic colour for each player. See pc/pc_splitscreen_tunic.h for the design.
+#include "d/dolzel.h" // IWYU pragma: keep
+#include "pc/pc_splitscreen_tunic.h"
+#include "pc/pc_harness.h"
+#include "pc/pc_settings.h"
+#include "pc_internal.h"
+
+#include "JSystem/J3DGraphAnimator/J3DModelData.h"
+#include "JSystem/J3DGraphBase/J3DTexture.h"
+#include "JSystem/JKernel/JKRExpHeap.h"
+#include "JSystem/JKernel/JKRHeap.h"
+#include "JSystem/JUtility/JUTNameTab.h"
+#include "d/actor/d_a_player_main.h"
+#include "m_Do/m_Do_ext.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <unistd.h>
+
+namespace {
+
+// --- Settings ------------------------------------------------------------------------------------
+
+struct Rgb {
+    float r, g, b;
+};
+
+// The menu's values (pc_menu.cpp, kSsTunic) and the colour each gives the tunic's main area; the
+// seams and lighter parts get darker and lighter shades of it. Index 0 keeps the game's colours;
+// "green" keeps the hero's clothes as the game has them and only makes the casual shirt green.
+struct Preset {
+    const char* value;
+    Rgb color;
+    bool gameHero;
+};
+const Preset kPresets[] = {
+    {"default", {0, 0, 0}, true},          {"red", {205, 52, 44}, false},     {"blue", {60, 110, 225}, false},
+    {"purple", {128, 72, 196}, false},     {"gold", {232, 184, 40}, false},   {"orange", {240, 128, 32}, false},
+    {"pink", {240, 122, 178}, false},      {"black", {52, 52, 60}, false},    {"white", {250, 250, 250}, false},
+    {"green", {90, 178, 74}, true},
+};
+constexpr int kPresetCount = (int)(sizeof(kPresets) / sizeof(kPresets[0]));
+
+const char* const kKeys[2] = {"COS_SS_P1_TUNIC", "COS_SS_P2_TUNIC"};
+// Without a value at all (the row not registered): player 1 the game's colours, player 2 red.
+const int kFallbackPreset[2] = {0, 1};
+
+int sPreset[2] = {-1, -1}; // -1: not read yet
+
+int presetOf(int player, const char* value) {
+    if (value == nullptr || value[0] == '\0') {
+        return kFallbackPreset[player];
+    }
+    for (int i = 0; i < kPresetCount; i++) {
+        if (strcmp(kPresets[i].value, value) == 0) {
+            return i;
+        }
+    }
+    return 0;
+}
+
+void onSetting(const char*, const char* value, void* user) {
+    const int player = (int)(intptr_t)user;
+    sPreset[player] = presetOf(player, value);
+}
+
+int presetFor(int player) {
+    if (sPreset[player] < 0) {
+        sPreset[player] = presetOf(player, pc_settings_get(kKeys[player]));
+        pc_settings_subscribe(kKeys[player], onSetting, (void*)(intptr_t)player);
+    }
+    return sPreset[player];
+}
+
+// --- Recolouring ---------------------------------------------------------------------------------
+// The tunic's pixels are picked out by hue, saturation and brightness: the greens of the hero's
+// clothes (hue 70-165; the hair's yellow is below 60, the skin and belt far below), the blues of
+// the casual shirt (hue 195-235; its palette has no other blue). Each becomes the chosen colour at
+// its own brightness relative to the main area's: darker ones scaled down, lighter ones (the hero's
+// light green undershirt) mixed toward white, so the hue stays and the shading is kept.
+
+enum class Outfit { Hero, Casual };
+
+constexpr Rgb kHeroReference = {90, 178, 74};    // the hero tunic's main green
+constexpr Rgb kCasualReference = {74, 117, 173}; // the casual shirt's main blue
+
+float smoothstep(float e0, float e1, float x) {
+    const float t = std::clamp((x - e0) / (e1 - e0), 0.0f, 1.0f);
+    return t * t * (3.0f - 2.0f * t);
+}
+
+// 1 inside [lo, hi] degrees, falling to 0 over `soft` degrees either side.
+float hueBand(float hue, float lo, float hi, float soft) {
+    return std::min(smoothstep(lo - soft, lo, hue), 1.0f - smoothstep(hi, hi + soft, hue));
+}
+
+void toHsv(const Rgb& c, float& h, float& s, float& v) {
+    const float r = c.r / 255.0f, g = c.g / 255.0f, b = c.b / 255.0f;
+    const float mx = std::max({r, g, b}), mn = std::min({r, g, b});
+    const float d = mx - mn;
+    v = mx;
+    s = mx > 0.0f ? d / mx : 0.0f;
+    if (d <= 0.0f) {
+        h = 0.0f;
+    } else if (mx == r) {
+        h = 60.0f * std::fmod((g - b) / d + 6.0f, 6.0f);
+    } else if (mx == g) {
+        h = 60.0f * ((b - r) / d + 2.0f);
+    } else {
+        h = 60.0f * ((r - g) / d + 4.0f);
+    }
+}
+
+float tunicWeight(Outfit outfit, const Rgb& c) {
+    float h, s, v;
+    toHsv(c, h, s, v);
+    const float band = outfit == Outfit::Hero ? hueBand(h, 70.0f, 165.0f, 10.0f) : hueBand(h, 195.0f, 235.0f, 12.0f);
+    return band * smoothstep(0.15f, 0.25f, s) * smoothstep(0.05f, 0.12f, v);
+}
+
+float luma(const Rgb& c) {
+    return 0.299f * c.r + 0.587f * c.g + 0.114f * c.b;
+}
+
+// The target at relative brightness k: darker scaled down, lighter mixed toward white by half the
+// excess (the hero's light green undershirt, k 1.4, becomes a lighter shade, not white).
+Rgb shade(const Rgb& target, float k) {
+    if (k <= 1.0f) {
+        return Rgb{target.r * k, target.g * k, target.b * k};
+    }
+    const float a = std::min(1.0f, (k - 1.0f) * 0.5f);
+    return Rgb{target.r + (255.0f - target.r) * a, target.g + (255.0f - target.g) * a,
+               target.b + (255.0f - target.b) * a};
+}
+
+Rgb recolor(Outfit outfit, const Rgb& c, const Rgb& target) {
+    const float w = tunicWeight(outfit, c);
+    if (w <= 0.0f) {
+        return c;
+    }
+    const Rgb& ref = outfit == Outfit::Hero ? kHeroReference : kCasualReference;
+    const Rgb m = shade(target, luma(c) / luma(ref));
+    return Rgb{c.r + (m.r - c.r) * w, c.g + (m.g - c.g) * w, c.b + (m.b - c.b) * w};
+}
+
+Rgb from565(u16 v) {
+    const unsigned r = (v >> 11) & 31, g = (v >> 5) & 63, b = v & 31;
+    return Rgb{(float)((r << 3) | (r >> 2)), (float)((g << 2) | (g >> 4)), (float)((b << 3) | (b >> 2))};
+}
+
+int quantize(float x, int bits) {
+    const int max = (1 << bits) - 1;
+    return std::clamp((int)std::lround(x / 255.0f * (float)max), 0, max);
+}
+
+u16 to565(const Rgb& c) {
+    return (u16)((quantize(c.r, 5) << 11) | (quantize(c.g, 6) << 5) | quantize(c.b, 5));
+}
+
+// GX CMPR: 8-byte blocks of two big-endian RGB565 end colours and sixteen 2-bit indices. Only the
+// end colours change; a block keeps its mode (four colours when the first is greater, else three
+// and transparent), swapping its end colours and their indices when the new ones compare the
+// other way. (The pattern of Dusklight's split-screen colours.)
+void recolorCmpr(u8* data, size_t size, const Rgb& target) {
+    for (size_t off = 0; off + 8 <= size; off += 8) {
+        u8* block = data + off;
+        const u16 c0 = (u16)((block[0] << 8) | block[1]);
+        const u16 c1 = (u16)((block[2] << 8) | block[3]);
+        u16 n0 = to565(recolor(Outfit::Hero, from565(c0), target));
+        u16 n1 = to565(recolor(Outfit::Hero, from565(c1), target));
+        if (n0 == c0 && n1 == c1) {
+            continue;
+        }
+        if (c0 > c1) {
+            if (n0 == n1) {
+                if (n1 > 0) {
+                    n1--;
+                } else {
+                    n0++;
+                }
+            }
+            if (n0 < n1) {
+                std::swap(n0, n1);
+                for (int i = 4; i < 8; i++) {
+                    block[i] ^= 0x55; // 0<->1, 2<->3
+                }
+            }
+        } else if (n0 > n1) {
+            std::swap(n0, n1);
+            for (int i = 4; i < 8; i++) {
+                u8 swapped = 0;
+                for (int p = 0; p < 4; p++) {
+                    u8 idx = (block[i] >> (6 - 2 * p)) & 3;
+                    if (idx < 2) {
+                        idx ^= 1; // the end colours swap; the midpoint and transparent stay
+                    }
+                    swapped |= (u8)(idx << (6 - 2 * p));
+                }
+                block[i] = swapped;
+            }
+        }
+        block[0] = (u8)(n0 >> 8);
+        block[1] = (u8)n0;
+        block[2] = (u8)(n1 >> 8);
+        block[3] = (u8)n1;
+    }
+}
+
+// A palette of big-endian RGB565 or RGB5A3 entries.
+void recolorTlut(u8* data, int count, u8 tlutFormat, const Rgb& target) {
+    for (int i = 0; i < count; i++) {
+        u8* e = data + i * 2;
+        const u16 v = (u16)((e[0] << 8) | e[1]);
+        u16 n;
+        if (tlutFormat == GX_TL_RGB565) {
+            n = to565(recolor(Outfit::Casual, from565(v), target));
+        } else if (v & 0x8000) { // RGB5A3, opaque: RGB555
+            const unsigned r = (v >> 10) & 31, g = (v >> 5) & 31, b = v & 31;
+            const Rgb c = recolor(Outfit::Casual,
+                                  Rgb{(float)((r << 3) | (r >> 2)), (float)((g << 3) | (g >> 2)),
+                                      (float)((b << 3) | (b >> 2))},
+                                  target);
+            n = (u16)(0x8000 | (quantize(c.r, 5) << 10) | (quantize(c.g, 5) << 5) | quantize(c.b, 5));
+        } else { // RGB5A3, translucent: A3 RGB444
+            const unsigned r = (v >> 8) & 15, g = (v >> 4) & 15, b = v & 15;
+            const Rgb c = recolor(Outfit::Casual, Rgb{(float)(r * 17), (float)(g * 17), (float)(b * 17)}, target);
+            n = (u16)((v & 0x7000) | (quantize(c.r, 4) << 8) | (quantize(c.g, 4) << 4) | quantize(c.b, 4));
+        }
+        e[0] = (u8)(n >> 8);
+        e[1] = (u8)n;
+    }
+}
+
+// --- Texture table copies ------------------------------------------------------------------------
+
+// A J3DTexture entry's image and palette: offsets from the entry itself (J3DTexture::setResTIMG).
+const u8* imageOf(const ResTIMG* t) {
+    return (const u8*)t + (s32)(u32)t->imageOffset;
+}
+const u8* paletteOf(const ResTIMG* t) {
+    return (const u8*)t + (s32)(u32)t->paletteOffset;
+}
+
+struct Copy {
+    J3DTexture* texture = nullptr; // host memory: the table object and its texture objects
+    u8* block = nullptr;           // the game heap: the copied headers, then the recoloured data
+    JKRHeap* heap = nullptr;
+};
+
+struct LinkState {
+    daPy_lk_c* link = nullptr;
+    Copy copy;
+    // What the copy was made from; it is made again when any of it changes.
+    int preset = 0;
+    J3DTexture* original = nullptr;
+    u16 num = 0;
+    u16 entry = 0;
+    const u8* image = nullptr;
+    const u8* palette = nullptr;
+    u8 format = 0;
+    // While the Link draws: the model data whose table is the copy, and its own table.
+    J3DModelData* swappedData = nullptr;
+    J3DTexture* swappedFrom = nullptr;
+};
+
+// One per Link (two in split-screen, room for a Link being deleted while the next is made).
+constexpr int kMaxLinks = 4;
+LinkState sLinks[kMaxLinks];
+
+// A copy that is replaced may still be named by the frame's draw lists and by GX commands not yet
+// drawn: it is kept a few frames. Fixed arrays: these run on the game thread inside the game's
+// heaps' scopes, where a growing container would take blocks of whatever JKRHeap is current.
+struct Retired {
+    Copy copy;
+    unsigned int frame = 0;
+};
+constexpr int kMaxRetired = 16;
+constexpr unsigned int kRetireFrames = 8;
+Retired sRetired[kMaxRetired];
+int sRetiredCount = 0;
+
+void freeCopy(Copy& copy) {
+    delete copy.texture; // host memory (JKRHeap's operator delete hands it back to the host)
+    if (copy.block != nullptr) {
+        JKRHeap::free(copy.block, copy.heap);
+    }
+    copy = Copy{};
+}
+
+void freeRetired() {
+    if (sRetiredCount == 0) {
+        return;
+    }
+    const unsigned int now = pc_frame_count();
+    for (Retired& r : sRetired) {
+        if (r.copy.texture != nullptr && now - r.frame > kRetireFrames) {
+            freeCopy(r.copy);
+            sRetiredCount--;
+        }
+    }
+}
+
+void retire(Copy& copy) {
+    if (copy.texture == nullptr) {
+        return;
+    }
+    Retired* slot = nullptr;
+    for (Retired& r : sRetired) {
+        if (r.copy.texture == nullptr) {
+            slot = &r;
+            break;
+        }
+        if (slot == nullptr || r.frame < slot->frame) {
+            slot = &r; // all in use: the oldest goes now
+        }
+    }
+    if (slot->copy.texture != nullptr) {
+        freeCopy(slot->copy);
+        sRetiredCount--;
+    }
+    slot->copy = copy;
+    slot->frame = pc_frame_count();
+    sRetiredCount++;
+    copy = Copy{};
+}
+
+LinkState* find(daPy_lk_c* link) {
+    for (LinkState& s : sLinks) {
+        if (s.link == link) {
+            return &s;
+        }
+    }
+    return nullptr;
+}
+
+bool isCopy(const J3DTexture* texture) {
+    for (const LinkState& s : sLinks) {
+        if (s.copy.texture != nullptr && s.copy.texture == texture) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// The clothes entry: the second "linktexS3TC" of the body model's texture table, as
+// daPy_lk_c::playerInit finds it (the first header is an unused duplicate) and swaps the casual
+// clothes into it. Found by name, so a Link that leaves the shared entry to the other (split-screen's
+// second Link) finds it too. -1 if there is none.
+int clothesEntry(J3DModelData* modelData) {
+    static const J3DTexture* sTexture = nullptr;
+    static const JUTNameTab* sNames = nullptr;
+    static int sEntry = -1;
+    J3DTexture* texture = modelData->getTexture();
+    JUTNameTab* names = modelData->getTextureName();
+    if (texture != sTexture || names != sNames) {
+        sTexture = texture;
+        sNames = names;
+        sEntry = -1;
+        int seen = 0;
+        for (u16 i = 0; names != nullptr && i < texture->getNum(); i++) {
+            const char* name = names->getName(i);
+            if (name != nullptr && strcmp(name, "linktexS3TC") == 0 && seen++ == 1) {
+                sEntry = i;
+                break;
+            }
+        }
+    }
+    return sEntry;
+}
+
+// The original table with entry `entry` recoloured. The headers are copied with their offsets
+// moved to the copy (the same images, J3DTexture::setResTIMG's arithmetic), so they live in a game
+// heap: every JKRHeap is in the MEM1 arena, within the 32-bit reach of the model's images.
+bool makeCopy(Copy& out, J3DTexture* original, u16 entry, const Rgb& target, Outfit& outfit) {
+    const u16 num = original->getNum();
+    const ResTIMG* src = original->getResTIMG(entry);
+    size_t payload;
+    if (!src->indexTexture && src->format == GX_TF_CMPR) {
+        outfit = Outfit::Hero;
+        payload = GXGetTexBufferSize(src->width, src->height, GX_TF_CMPR, src->mipmapEnabled ? GX_TRUE : GX_FALSE,
+                                     src->mipmapCount);
+    } else if (src->indexTexture && (src->colorFormat == GX_TL_RGB565 || src->colorFormat == GX_TL_RGB5A3)) {
+        outfit = Outfit::Casual;
+        payload = (size_t)src->numColors * 2;
+    } else {
+        return false;
+    }
+    const size_t headers = (size_t)num * sizeof(ResTIMG);
+    JKRHeap* heap = mDoExt_getGameHeap();
+    u8* block = (u8*)JKRHeap::alloc((u32)(headers + ((payload + 0x1F) & ~(size_t)0x1F)), 0x20, heap);
+    if (block == nullptr) {
+        return false;
+    }
+    ResTIMG* res = (ResTIMG*)block;
+    for (u16 i = 0; i < num; i++) {
+        const ResTIMG* o = original->getResTIMG(i);
+        res[i] = *o;
+        const intptr_t delta = (intptr_t)o - (intptr_t)&res[i];
+        const bool reach = delta == (intptr_t)(s32)delta;
+        res[i].imageOffset = (u32)o->imageOffset + (u32)(s32)delta;
+        res[i].paletteOffset = (u32)o->paletteOffset + (u32)(s32)delta;
+        if (!reach || imageOf(&res[i]) != imageOf(o) || (o->indexTexture && paletteOf(&res[i]) != paletteOf(o))) {
+            JKRHeap::free(block, heap);
+            return false;
+        }
+    }
+    u8* data = block + headers;
+    if (outfit == Outfit::Hero) {
+        memcpy(data, imageOf(src), payload);
+        recolorCmpr(data, payload, target);
+        res[entry].imageOffset = (u32)(data - (u8*)&res[entry]);
+    } else {
+        memcpy(data, paletteOf(src), payload);
+        recolorTlut(data, src->numColors, src->colorFormat, target);
+        res[entry].paletteOffset = (u32)(data - (u8*)&res[entry]);
+    }
+    {
+        // The constructor builds a texture object per entry from the headers just written.
+        JKRPcHostAllocScope host;
+        out.texture = new J3DTexture(num, res);
+    }
+    out.block = block;
+    out.heap = heap;
+    return true;
+}
+
+} // namespace
+
+void pc_ss_tunic_apply(daPy_lk_c* link, int player) {
+    if (link == nullptr || player < 0 || player > 1) {
+        return;
+    }
+    const int preset = presetFor(player);
+    LinkState* s = find(link);
+    if (preset == 0 && s == nullptr && sRetiredCount == 0) {
+        return; // the game's colours, and nothing of ours to free
+    }
+    freeRetired();
+    J3DModelData* modelData = link->pcBodyModelData();
+    J3DTexture* original = modelData != nullptr ? modelData->getTexture() : nullptr;
+    const int entry = original != nullptr && !isCopy(original) ? clothesEntry(modelData) : -1;
+    const ResTIMG* clothes = entry >= 0 ? original->getResTIMG((u16)entry) : nullptr;
+    if (preset == 0 || clothes == nullptr || (!clothes->indexTexture && kPresets[preset].gameHero)) {
+        if (s != nullptr) {
+            retire(s->copy);
+            *s = LinkState{};
+        }
+        return;
+    }
+    if (s == nullptr) {
+        s = find(nullptr);
+        if (s == nullptr) {
+            return;
+        }
+        s->link = link;
+    }
+    const u8* image = imageOf(clothes);
+    const u8* palette = clothes->indexTexture ? paletteOf(clothes) : nullptr;
+    if (s->preset != preset || s->original != original || s->num != original->getNum() || s->entry != entry ||
+        s->image != image || s->palette != palette || s->format != clothes->format)
+    {
+        retire(s->copy);
+        s->preset = preset;
+        s->original = original;
+        s->num = original->getNum();
+        s->entry = (u16)entry;
+        s->image = image;
+        s->palette = palette;
+        s->format = clothes->format;
+        Outfit outfit = Outfit::Hero;
+        const bool made = makeCopy(s->copy, original, (u16)entry, kPresets[preset].color, outfit);
+        pc::writef(STDERR_FILENO, "[cos] split-screen tunic: player %d's Link: %s on the %s clothes (entry %d)%s\n",
+                   player + 1, kPresets[preset].value, outfit == Outfit::Hero ? "hero's" : "casual",
+                   (int)entry, made ? "" : ": not recoloured (format or memory)");
+    }
+    if (s->copy.texture != nullptr) {
+        s->swappedData = modelData;
+        s->swappedFrom = original;
+        modelData->setTexture(s->copy.texture);
+    }
+}
+
+void pc_ss_tunic_restore(daPy_lk_c* link) {
+    LinkState* s = find(link);
+    if (s == nullptr || s->swappedData == nullptr) {
+        return;
+    }
+    // The frozen material's backup (dMat_control_c::push/pop) gives the copy back within the draw.
+    if (s->swappedData->getTexture() == s->copy.texture) {
+        s->swappedData->setTexture(s->swappedFrom);
+    }
+    s->swappedData = nullptr;
+    s->swappedFrom = nullptr;
+}
+
+void pc_ss_tunic_on_link_delete(daPy_lk_c* link) {
+    LinkState* s = find(link);
+    if (s == nullptr) {
+        return;
+    }
+    pc_ss_tunic_restore(link);
+    retire(s->copy);
+    *s = LinkState{};
+}
+
+void pc_ss_tunic_on_scene_delete() {
