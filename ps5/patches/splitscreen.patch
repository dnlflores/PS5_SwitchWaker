new file mode 100644
index 0000000..c336e84
--- /dev/null
+++ b/native/include/pc/pc_splitscreen.h
@@ -0,0 +1,128 @@
+#pragma once
+
+// Split-screen co-op: two players, each with their own Link, camera, controller and half of
+// the screen. Player 1 is the Link the stage creates; Player 2's Link and camera are created
+// next to them. Implementation: native/src/pc/game_hooks/pc_splitscreen.cpp. Notes:
+// docs/SPLITSCREEN.md.
+//
+// The player context (pc_splitscreen_ctx.h) decides whose slot index 0 of the player, camera
+// and pad tables means while code runs:
+// - each player's own processes (their Link, camera, boat, and whatever those create) run as
+//   that player, through pc_ss_process_scope around every process method;
+// - everything else (the world: NPCs, enemies, events, rooms, menus) runs as the lead. The lead
+//   is whoever last talked to someone, opened a door or a chest, got an item or paused
+//   (Player 1 when a scene starts).
+
+#include "pc/pc_splitscreen_ctx.h"
+
+#include <stdint.h>
+
+struct base_process_class;
+class camera_class;
+class fopAc_ac_c;
+class dAttention_c;
+typedef uint32_t fpc_ProcID;
+
+// Registers the "Split-screen co-op" setting (pc_main.cpp, with the other modules).
+void pc_ss_init();
+// The setting is on.
+bool pc_ss_enabled();
+// Player 2 is in the scene and the screen is split now.
+bool pc_ss_active();
+// 2 while the screen is split, else 1.
+int pc_ss_window_count();
+// Each view's aspect ratio against the full screen's (0.5 side by side), 1 when not split.
+float pc_ss_aspect_scale();
+
+// Player 2's Link (NULL when there is none).
+fopAc_ac_c* pc_ss_player2();
+bool pc_ss_is_player2(const fopAc_ac_c* actor);
+// Either player's Link, while there are two.
+bool pc_ss_is_player_link(const fopAc_ac_c* actor);
+// The Link of the player who does not lead (cutscenes cast the lead's).
+bool pc_ss_is_non_lead_link(const fopAc_ac_c* actor);
+// Either player's boat, while there are two.
+bool pc_ss_is_player_ship(const fopAc_ac_c* actor);
+// Not a lock-on target of that player: either Link, or the other player's boat.
+bool pc_ss_hidden_from(const fopAc_ac_c* actor, const fopAc_ac_c* owner);
+// The player (0 or 1) whose Link this is; 0 for anything else.
+int pc_ss_link_player(const fopAc_ac_c* link);
+// A second Link was created in this scene: both use the model data Link's archive holds, so
+// each binds its own animation state to it before it is calculated or drawn.
+bool pc_ss_links_share_model_data();
+
+// Process bookkeeping (f_pc_base.cpp).
+void pc_ss_on_proc_id_made(fpc_ProcID id);
+void pc_ss_on_proc_deleted(fpc_ProcID id);
+// A process of the player who is waiting while the lead is in a cutscene or a menu.
+bool pc_ss_is_suspended_proc(const base_process_class* proc);
+// The player (0 or 1) a process belongs to, or -1 for the world.
+int pc_ss_owner_of(const base_process_class* proc);
+// The owner of the process running now (-1: the world).
+int pc_ss_current_owner();
+
+// Context for a process's methods (f_pc_method.cpp, f_pc_draw.cpp).
+class pc_ss_process_scope {
+public:
+    explicit pc_ss_process_scope(const base_process_class* proc);
+    ~pc_ss_process_scope();
+    pc_ss_process_scope(const pc_ss_process_scope&) = delete;
+    pc_ss_process_scope& operator=(const pc_ss_process_scope&) = delete;
+
+private:
+    pc_ss_ctx_t mSaved;
+    int mSavedOwner;
+    bool mChanged;
+};
+
+// Context for code that acts for one player outside their processes.
+class pc_ss_scoped_ctx {
+public:
+    pc_ss_scoped_ctx(uint8_t player, uint8_t camera);
+    ~pc_ss_scoped_ctx();
+    pc_ss_scoped_ctx(const pc_ss_scoped_ctx&) = delete;
+    pc_ss_scoped_ctx& operator=(const pc_ss_scoped_ctx&) = delete;
+
+private:
+    pc_ss_ctx_t mSaved;
+    int mSavedOwner;
+};
+
+// Draws: fpcDw_Execute marks that a draw method runs (cameras then use their own index, the
+// rest the camera of the half being drawn).
+bool pc_ss_set_in_draw(bool in_draw);
+
+// The pads were read (mDoCPd_Read).
+void pc_ss_on_pads_read();
+
+// The play scene (d_s_play.cpp).
+void pc_ss_on_scene_play_create();
+void pc_ss_on_scene_play_execute();
+void pc_ss_on_scene_play_draw();
+void pc_ss_on_scene_play_delete();
+
+// The painter (m_Do_graphic.cpp): one pass per half of the screen.
+void pc_ss_begin_pass(int window);
+void pc_ss_end_pass();
+// Enters the 3D scene into the draw lists again, through the camera of window 1.
+void pc_ss_redraw_scene_for_window();
+// Puts Player 1's view back (j3dSys, the draw list's view, the clipper) after the painter.
+void pc_ss_restore_view();
+bool pc_ss_in_extra_view_pass();
+// The second view is being drawn, or the paint is frame interpolation's extra one: paint-time
+// animation (fades, the sea, the sky) must not advance.
+bool pc_ss_paint_is_repeat();
+
+// Cameras (d_camera.cpp).
+// The camera whose view is being drawn or set up now (the other one keeps its view to itself).
+bool pc_ss_is_pass_camera(const camera_class* camera);
+// The lead's camera: the sound listener, motion blur, focus.
+bool pc_ss_is_audio_camera(const camera_class* camera);
+
+// What the player who does not lead may not do (stage, room, restart changes; events).
+bool pc_ss_block_scene_change();
+bool pc_ss_block_global_change();
+bool pc_ss_block_event_order(uint16_t type);
+// Damage taken by Player 2 is not taken off the shared hearts.
+bool pc_ss_drops_damage();
+int pc_ss_lead();
diff --git a/native/include/pc/pc_splitscreen_ctx.h b/native/include/pc/pc_splitscreen_ctx.h
new file mode 100644
index 0000000..b8cd344
--- /dev/null
+++ b/native/include/pc/pc_splitscreen_ctx.h
@@ -0,0 +1,44 @@
+#pragma once
+
+// Split-screen co-op: the "player context".
+//
+// The game was written for one player. Rather than touching the thousands of places that ask
+// for "the player" (dComIfGp_getPlayer(0), dComIfGp_getLinkPlayer()), "the camera"
+// (dComIfGp_getCamera(0)) or "the pad" (CPad_*(0)), the per-player tables have a second slot
+// on PC (d_com_inf_game.h) and these two values decide which slot index 0 means right now:
+//
+//   player  1 while Player 2's own processes (their Link, camera, boat, and what those
+//           create) run. Index 0 of the player tables and pad 0 then mean Player 2.
+//   camera  1 while Player 2's camera runs, or while Player 2's half of the screen is drawn.
+//           Index 0 of the camera tables then means Player 2's camera.
+//
+// Indices 0 and 1 swap; anything else passes through. Stored values that are themselves
+// indices (a camera's player, a player's camera) are kept physical and go through the same
+// swap when read or written.
+//
+// Included by d_com_inf_game.h and m_Do_controller_pad.h, so it has no dependencies.
+
+#include <stdint.h>
+
+struct pc_ss_ctx_t {
+    uint8_t player;
+    uint8_t camera;
+};
+
+extern pc_ss_ctx_t g_pc_ss_ctx;
+
+inline int pc_ss_remap_player(int i) {
+    return (i == 0 || i == 1) ? (i ^ g_pc_ss_ctx.player) : i;
+}
+
+inline int pc_ss_remap_camera(int i) {
+    return (i == 0 || i == 1) ? (i ^ g_pc_ss_ctx.camera) : i;
+}
+
+inline uint32_t pc_ss_remap_pad(uint32_t pad) {
+    return pad <= 1 ? (pad ^ g_pc_ss_ctx.player) : pad;
+}
+
+inline bool pc_ss_in_p2() {
+    return g_pc_ss_ctx.player != 0;
+}
diff --git a/native/include/pc/pc_splitscreen_tunic.h b/native/include/pc/pc_splitscreen_tunic.h
new file mode 100644
index 0000000..6e0f2d1
--- /dev/null
+++ b/native/include/pc/pc_splitscreen_tunic.h
@@ -0,0 +1,51 @@
+/*
+ * pc_splitscreen_tunic.h - Split-screen: a tunic colour for each player
+ * (native/src/pc/game_hooks/pc_splitscreen_tunic.cpp).
+ *
+ * Settings (options menu, Gráficos; saved in settings.ini like the other rows):
+ *   COS_SS_P1_TUNIC  player 1's colour, default "default" (the game's own colours)
+ *   COS_SS_P2_TUNIC  player 2's colour, default "red"
+ * Values: default, red, blue, purple, gold, orange, pink, black, white, green ("green" leaves the
+ * hero's clothes as the game has them and turns the casual shirt green).
+ *
+ * Link's clothes are one texture of his body model (cl.bdl): the hero's clothes are the S3TC atlas
+ * "linktexS3TC" (GX CMPR; tunic and cap, skin, hair, belt and boots in one image), the clothes he
+ * starts in are linktexbci4 (CI4 with a 16-colour palette), which daPy_lk_c copies over that same
+ * texture table entry (mpCurrLinktex). Only the tunic's greens (hero) or the shirt's blues (casual) are
+ * moved to the chosen colour, keeping their shading; the rest of the atlas stays as it is.
+ *
+ * The model data is shared by every Link, and on PC a material packet takes its textures from the
+ * table that was j3dSys's when its display list was recorded (J3DMatPacket::recordTexture, at every
+ * diff for Link, whose diff flag has texture numbers). So each Link with a colour gets its own copy
+ * of the table (the headers copied, the clothes entry pointing at a recoloured image or palette), and
+ * the model data's table is that copy for the length of the Link's draw: everything the draw records
+ * (calcMaterial, diff, entry, the face's entryIn, the frozen material's backup) takes the copy, and
+ * the packets keep it until the draw lists are drawn. When the outfit changes (the shared entry is
+ * swapped in place), the copy is made again from the new one.
+ */
+#ifndef PC_SPLITSCREEN_TUNIC_H
+#define PC_SPLITSCREEN_TUNIC_H
+
+class daPy_lk_c;
+
+// Split-screen: points this Link's body model at a copy of its texture table with player `player`'s
+// (0 or 1) tunic colour, until pc_ss_tunic_restore. Called at the start of daPy_lk_c::draw. With the
+// colour "default" and no copy made yet it only reads a cached setting.
+void pc_ss_tunic_apply(daPy_lk_c* link, int player);
+// Split-screen: gives the shared model data its own texture table back (end of daPy_lk_c::draw).
+void pc_ss_tunic_restore(daPy_lk_c* link);
+// Split-screen: frees this Link's copy (daPy_lk_c::playerDelete), a few frames later.
+void pc_ss_tunic_on_link_delete(daPy_lk_c* link);
+// Split-screen: frees what the scene's Links left (the PLAY scene's delete).
+void pc_ss_tunic_on_scene_delete();
+
+// Split-screen: pc_ss_tunic_apply for the length of a scope, restored on every return of the draw.
+struct PcSsTunicDrawScope {
+    daPy_lk_c* link;
+    PcSsTunicDrawScope(daPy_lk_c* l, int player) : link(l) { pc_ss_tunic_apply(l, player); }
+    ~PcSsTunicDrawScope() { pc_ss_tunic_restore(link); }
+    PcSsTunicDrawScope(const PcSsTunicDrawScope&) = delete;
+    PcSsTunicDrawScope& operator=(const PcSsTunicDrawScope&) = delete;
+};
+
+#endif
