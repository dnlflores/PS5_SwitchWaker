+    done = true;
+    static const PcSettingChoice kChoices[] = {
+        {"0", "Desactivado", "Off"},
+        {"1", "Dos jugadores", "Two players"},
+    };
+    PcSettingDesc d = {};
+    d.key = kSettingKey;
+    d.label = "Pantalla dividida (cooperativo)";
+    d.help = "Un segundo Link con el mando 2, cada uno con su mitad de la pantalla. Desactiva los 60 fps.";
+    d.labelEn = "Split-screen co-op";
+    d.helpEn = "A second Link on controller 2, half of the screen each. Turns 60 fps interpolation off.";
+    d.tab = PC_SETTING_TAB_GRAPHICS;
+    d.flags = 0;
+    d.choices = kChoices;
+    d.choiceCount = 2;
+    d.defaultValue = "0";
+    d.apply = [](const char*, const char*, void*) { readSetting(); };
+    d.order = 95;  // above the two tunic rows (pc_menu.cpp, 96 and 97)
+    pc_settings_register(&d);
+    readSetting();
+}
