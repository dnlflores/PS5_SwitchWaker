diff --git a/native/src/pc/game_hooks/pc_splitscreen.cpp b/native/src/pc/game_hooks/pc_splitscreen.cpp
new file mode 100644
index 0000000..c5bfc27
--- /dev/null
+++ b/native/src/pc/game_hooks/pc_splitscreen.cpp
@@ -0,0 +1,910 @@
+// Split-screen co-op: Player 2's Link, camera and context, and who leads.
+// See pc/pc_splitscreen.h and docs/SPLITSCREEN.md.
+
+#include "d/dolzel.h" // IWYU pragma: keep
+#include "pc/pc_splitscreen.h"
+#include "pc/pc_settings.h"
+#include "pc_internal.h"
+
+#include "JSystem/J3DGraphBase/J3DSys.h"
+#include "JSystem/JKernel/JKRExpHeap.h"
+#include "JSystem/JKernel/JKRHeap.h"
+#include "SSystem/SComponent/c_malloc.h"
+#include "d/actor/d_a_player.h"
+#include "d/d_attention.h"
+#include "d/d_bg_s_gnd_chk.h"
+#include "d/d_camera.h"
+#include "d/d_com_inf_game.h"
+#include "d/d_meter.h"
+#include "f_op/f_op_actor_mng.h"
+#include "f_op/f_op_camera.h"
+#include "f_op/f_op_camera_mng.h"
+#include "f_op/f_op_draw_iter.h"
+#include "f_op/f_op_msg.h"
+#include "f_pc/f_pc_base.h"
+#include "f_pc/f_pc_executor.h"
+#include "f_pc/f_pc_manager.h"
+#include "f_pc/f_pc_name.h"
+#include "m_Do/m_Do_controller_pad.h"
+#include "m_Do/m_Do_ext.h"
+#include "m_Do/m_Do_lib.h"
+#include "m_Do/m_Do_machine.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <unistd.h>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+pc_ss_ctx_t g_pc_ss_ctx = {0, 0};
+
+namespace {
+
+const char kSettingKey[] = "COS_SPLITSCREEN";
+
+// Player 2 is brought back next to Player 1 past these distances, or after this long in another
+// room.
+constexpr f32 kLeashDistance = 2000.0f;
+constexpr f32 kHardLeashDistance = 4500.0f;
+// At sea the players may sail further apart (the islands load around the lead).
+constexpr f32 kSailingLeashDistance = 8000.0f;
+constexpr f32 kSailingHardLeashDistance = 12000.0f;
+constexpr int kSeparatedFramesLimit = 45;
+constexpr int kPruneInterval = 60;
+constexpr int kPendingDeleteGiveUpFrames = 300;
+
+constexpr fpc_ProcID kNoProc = fpcM_ERROR_PROCESS_ID_e;
+
+// Processes owned by Player 2 (s_owned) and Player 1 (s_ownedP1): each player's own processes
+// (their Link, camera, boat, and what those create) run as that player; anything else as the lead.
+std::unordered_set<fpc_ProcID> s_owned;
+std::unordered_set<fpc_ProcID> s_ownedP1;
+// Player 2's processes that were told to go and have not been deleted yet. A process leaves the
+// executor (search stops finding it) as soon as it is queued for deletion, but its delete method
+// runs later; the next Player 2 is not created until the last one is really gone.
+std::unordered_set<fpc_ProcID> s_pendingDelete;
+int s_pendingDeleteFrames = 0;
+fpc_ProcID s_p2LinkId = kNoProc;
+fpc_ProcID s_p2CameraId = kNoProc;
+fpc_ProcID s_p2ShipId = kNoProc;
+
+// The lead is the player the world follows: whose Link the NPCs, events, doors, rooms and menus
+// see as "the player", and whose camera shows the cutscenes. It is whoever last talked to
+// someone, opened a door or a chest, got an item or paused (Player 1 when a scene starts).
+uint8_t s_lead = 0;
+// Context scopes in progress, and the owner (0, 1, or -1 for the world) of the process running
+// now; what a process creates belongs to its owner.
+int s_scopeDepth = 0;
+int s_curOwner = -1;
+bool s_inPass = false;
+bool s_bringPlayer1Requested = false;
+// Whether Player 2's camera is up, worked out once a frame: pc_ss_active() is asked for every
+// process drawn, and looking a process up walks the process list.
+bool s_p2CameraReady = false;
+bool s_enabled = false;
+
+bool s_sceneActive = false;
+bool s_spawnedThisScene = false;
+bool s_inDraw = false;
+uint8_t s_passCamera = 0;  // physical camera of the half being drawn
+bool s_extraPass = false;
+bool s_suspended = false;
+bool s_respawnRequested = false;
+int s_cooldown = 0;
+int s_separatedFrames = 0;
+int s_pruneTimer = 0;
+
+void* s_p2AttentionMem = nullptr;
+dAttention_c* s_p2Attention = nullptr;
+
+// The per-frame HUD state that belongs to whichever Link is running: the button prompts it sets
+// and its air meter. The live copy is the running player's; the bank holds the other player's.
+struct Bank {
+    s32 airMeter = 0;
+    s32 itemTimeMax = 0;
+    bool swimTimerStatus = false;
+    u8 status[6] = {};
+};
+Bank s_bank;
+
+dComIfG_play_c& play() { return g_dComIfG_gameInfo.play; }
+
+void swapBank() {
+    dComIfG_play_c& p = play();
+    std::swap(p.mAirMeter, s_bank.airMeter);
+    std::swap(p.mItemTimeMax, s_bank.itemTimeMax);
+    std::swap(p.mItemSwimTimerStatus, s_bank.swimTimerStatus);
+    u8* live[6] = {&p.mRStatus, &p.mAStatus, &p.mDoStatus, &p.mRStatusForce, &p.mAStatusForce, &p.mDoStatusForce};
+    for (int i = 0; i < 6; i++) {
+        std::swap(*live[i], s_bank.status[i]);
+    }
+}
+
+void initBankFromLive() {
+    s_bank = Bank();
+    s_bank.airMeter = play().mAirMeter;
+    s_bank.itemTimeMax = play().mItemTimeMax;
+}
+
+void switchTo(pc_ss_ctx_t to) {
+    if (to.player != g_pc_ss_ctx.player) {
+        swapBank();
+    }
+    g_pc_ss_ctx = to;
+}
+
+int ownerOf(const base_process_class* proc) {
+    if (proc == nullptr) {
+        return -1;
+    }
+    if (!s_owned.empty() && s_owned.count(proc->mBsPcId) != 0) {
+        return 1;
+    }
+    if (!s_ownedP1.empty() && s_ownedP1.count(proc->mBsPcId) != 0) {
+        return 0;
+    }
+    return -1;
+}
+
+int windowCountNow();
+void setLead(uint8_t lead, const char* why);
+
+// The camera the scene is being drawn for: the half's while a half is drawn; otherwise the first
+// half's (Player 1's), or the lead's when the screen is not split.
+uint8_t passCamera() {
+    if (s_inPass) {
+        return s_passCamera;
+    }
+    return windowCountNow() > 1 ? 0 : s_lead;
+}
+
+// The context outside any process: the lead's.
+pc_ss_ctx_t topCtx() {
+    return {s_lead, s_inPass ? s_passCamera : s_lead};
+}
+
+void leaveScope(pc_ss_ctx_t saved, int savedOwner) {
+    s_scopeDepth--;
+    s_curOwner = savedOwner;
+    // The outermost scope goes back to the lead's context, which may have changed while it ran.
+    const pc_ss_ctx_t to = s_scopeDepth == 0 ? topCtx() : saved;
+    if (to.player != g_pc_ss_ctx.player || to.camera != g_pc_ss_ctx.camera) {
+        switchTo(to);
+    }
+}
+
+bool isCameraProc(const base_process_class* proc) {
+    return proc->mProcName == fpcNm_CAMERA_e || proc->mProcName == fpcNm_CAMERA2_e;
+}
+
+bool procAlive(fpc_ProcID id) {
+    return id != kNoProc && (fpcEx_SearchByID(id) != NULL || fpcM_IsCreating(id));
+}
+
+bool procCreated(fpc_ProcID id) {
+    return id != kNoProc && fpcEx_SearchByID(id) != NULL && !fpcM_IsCreating(id);
+}
+
+void deleteProc(fpc_ProcID id) {
+    if (base_process_class* proc = fpcEx_SearchByID(id)) {
+        fpcM_Delete(proc);
+    }
+}
+
+void log(const char* what) {
+    pc::writef(STDERR_FILENO, "[cos] splitscreen: %s\n", what);
+}
+
+void createAttention() {
+    if (s_p2Attention != nullptr) {
+        return;
+    }
+    s_p2AttentionMem = JKRHeap::alloc(sizeof(dAttention_c), 4, mDoExt_getGameHeap());
+    if (s_p2AttentionMem == nullptr) {
+        log("no memory for Player 2's lock-on");
+        return;
+    }
+    // Run() calls Init() with Player 2 once they are there.
+    s_p2Attention = new (s_p2AttentionMem) dAttention_c(NULL, PAD_1);
+    play().mpPlayer2Attention = s_p2Attention;
+}
+
+void destroyAttention() {
+    play().mpPlayer2Attention = nullptr;
+    if (s_p2Attention != nullptr) {
+        s_p2Attention->~dAttention_c();
+        s_p2Attention = nullptr;
+    }
+    if (s_p2AttentionMem != nullptr) {
+        JKRHeap::free(s_p2AttentionMem, NULL);
+        s_p2AttentionMem = nullptr;
+    }
+}
+
+void setupTables() {
+    // Window 1 is drawn full size, like window 0, by a camera of half the aspect ratio; the
+    // painter then puts each in its half of the screen.
+    play().setWindow(1, 0.0f, 0.0f, mDoMch_render_c::getFbWidth(), mDoMch_render_c::getEfbHeight(), 0.0f, 1.0f, 1,
+                     2);
+    play().setCameraInfoPhysical(1, NULL, 1, 1, -1);
+    play().setPlayerInfoPhysical(1, NULL, 1);
+    play().mCameraInfo[1].mCameraZoomScale = play().mCameraInfo[0].mCameraZoomScale;
+    play().mCameraInfo[1].mCameraZoomForcus = play().mCameraInfo[0].mCameraZoomForcus;
+}
+
+bool groundNear(cXyz* pos, f32 refY, f32 maxStep) {
+    dBgS_GndChk gnd;
+    cXyz probe(pos->x, refY + 60.0f, pos->z);
+    gnd.SetPos(&probe);
+    const f32 y = dComIfG_Bgsp()->GroundCross(&gnd);
+    if (y == -G_CM3D_F_INF || std::fabs(y - refY) > maxStep) {
+        return false;
+    }
+    pos->y = y;
+    return true;
+}
+
+cXyz spawnPosition(fopAc_ac_c* next) {
+    // Beside the Link joined (not behind: that is in front of their camera), on ground at their
+    // height; else behind or in front (on a narrow pier there may be only one way). On them when
+    // there is none (at sea).
+    static const s16 kDirs[] = {(s16)0xC000, 0x4000, (s16)0x8000, 0x0000};
+    static const f32 kDists[] = {100.0f, 70.0f};
+    for (f32 d : kDists) {
+        for (s16 dir : kDirs) {
+            const s16 a = next->shape_angle.y + dir;
+            cXyz pos(next->current.pos.x + cM_ssin(a) * d, next->current.pos.y, next->current.pos.z + cM_scos(a) * d);
+            if (groundNear(&pos, next->current.pos.y, 30.0f)) {
+                return pos;
+            }
+        }
+    }
+    return next->current.pos;
+}
+
+void spawn(fopAc_ac_c* p1) {
+    setupTables();
+    createAttention();
+    initBankFromLive();
+
+    cXyz pos = spawnPosition(p1);
+    csXyz angle(0, p1->shape_angle.y, 0);
+    // Room bits from Player 1's room; 0x40: not a restart point; start event 0xFF: none.
+    const u32 params = 0xFF000000u | 0x40u | (static_cast<u32>(fopAcM_GetRoomNo(p1)) & 0x3F);
+
+    pc_ss_scoped_ctx ctx(1, 1);
+
+    auto* camPrm = static_cast<fopCamM_prm_class*>(cMl::memalignB(-4, sizeof(fopCamM_prm_class)));
+    if (camPrm == nullptr) {
+        log("no memory for Player 2's camera");
+        return;
+    }
+    std::memset(camPrm, 0, sizeof(fopCamM_prm_class));
+    // Camera index 1 (the camera's parameter, host order on PC). The game's unused second
+    // camera profile skips the minimap.
+    camPrm->base.parameters = 1;
+    s_p2CameraId = fopCamM_Create(1, fpcNm_CAMERA2_e, camPrm);
+
+    // Room -1, as Player 1 is created: the actor is not deleted with a room.
+    s_p2LinkId = fopAcM_create(fpcNm_PLAYER_e, params, &pos, -1, &angle);
+
+    s_suspended = false;
+    s_respawnRequested = false;
+    s_separatedFrames = 0;
+    s_spawnedThisScene = true;
+    pc::writef(STDERR_FILENO, "[cos] splitscreen: Player 2 joins (link %u, camera %u)\n", s_p2LinkId, s_p2CameraId);
+}
+
+void despawn() {
+    // Everything of Player 2's goes: their Link, camera, and what the Link had out (a bomb, an
+    // arrow), which would otherwise look for a Player 2 who is not there.
+    const std::vector<fpc_ProcID> ids(s_owned.begin(), s_owned.end());
+    for (fpc_ProcID id : ids) {
+        if (procCreated(id) && fpcM_Delete(fpcEx_SearchByID(id))) {
+            s_pendingDelete.insert(id);
+        }
+    }
+    s_pendingDeleteFrames = 0;
+
+    // Nothing may find the old Player 2 from here on: not the next Player 2's camera looking for
+    // its player, not the lock-on.
+    play().setPlayerInfoPhysical(1, NULL, 1);
+    play().mPlayer2LinkPtr = NULL;
+    play().mPlayer2ShipPtr = NULL;
+    play().mCameraInfo[1].mpCamera = NULL;
+    std::memset(play().mPlayerStatus[1], 0, sizeof(play().mPlayerStatus[1]));
+
+    s_p2LinkId = kNoProc;
+    s_p2CameraId = kNoProc;
+    s_p2ShipId = kNoProc;
+    s_p2CameraReady = false;
+    s_suspended = false;
+    s_respawnRequested = false;
+    s_separatedFrames = 0;
+    setLead(0, "Player 2 leaves");
+}
+
+void prune() {
+    for (auto it = s_owned.begin(); it != s_owned.end();) {
+        if (!procAlive(*it) && s_pendingDelete.count(*it) == 0) {
+            it = s_owned.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    for (auto it = s_ownedP1.begin(); it != s_ownedP1.end();) {
+        it = procAlive(*it) ? std::next(it) : s_ownedP1.erase(it);
+    }
+}
+
+void setLead(uint8_t lead, const char* why) {
+    if (lead == s_lead) {
+        return;
+    }
+    s_lead = lead;
+    pc::writef(STDERR_FILENO, "[cos] splitscreen: Player %d leads (%s)\n", lead + 1, why);
+    if (s_scopeDepth == 0) {
+        switchTo(topCtx());
+    }
+    // Otherwise the outermost scope switches as it ends.
+}
+
+// Player 1's Link and camera, and from them on what they create.
+void markPlayer1(fopAc_ac_c* p1) {
+    s_ownedP1.insert(fopAcM_GetID(p1));
+    if (camera_class* cam = play().getCameraPhysical(0)) {
+        s_ownedP1.insert(fpcM_GetID(cam));
+    }
+}
+
+// Player 1 cannot be created again (they are the Link the stage made), so when Player 2 leads
+// and they get separated, Player 1 is moved to Player 2.
+void bringPlayer1ToLead(fopAc_ac_c* p1, fopAc_ac_c* p2) {
+    cXyz pos = spawnPosition(p2);
+    pc_ss_scoped_ctx ctx(0, 0);
+    static_cast<daPy_py_c*>(p1)->setPlayerPosAndAngle(&pos, p2->shape_angle.y);
+    fopAcM_SetRoomNo(p1, fopAcM_GetRoomNo(p2));
+}
