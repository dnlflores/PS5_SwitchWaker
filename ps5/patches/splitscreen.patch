+pc_ss_process_scope::pc_ss_process_scope(const base_process_class* proc)
+    : mSaved(g_pc_ss_ctx), mSavedOwner(s_curOwner), mChanged(false) {
+    if (s_owned.empty() && s_lead == 0 && s_scopeDepth == 0 && !s_inPass) {
+        return;  // one player: nothing to switch
+    }
+    mChanged = true;
+    s_scopeDepth++;
+    if (proc == nullptr) {
+        return;
+    }
+    // A player's process runs as that player, anything else as the lead. Draws use the camera of
+    // the half being drawn, except a camera's own draw, which sees itself as its player's camera.
+    const int owner = ownerOf(proc);
+    s_curOwner = owner;
+    const uint8_t player = owner >= 0 ? static_cast<uint8_t>(owner) : s_lead;
+    pc_ss_ctx_t to;
+    to.player = player;
+    to.camera = (s_inDraw && !isCameraProc(proc)) ? passCamera() : player;
+    if (to.player != g_pc_ss_ctx.player || to.camera != g_pc_ss_ctx.camera) {
+        switchTo(to);
+    }
+}
+
+pc_ss_process_scope::~pc_ss_process_scope() {
+    if (mChanged) {
+        leaveScope(mSaved, mSavedOwner);
+    }
+}
+
+pc_ss_scoped_ctx::pc_ss_scoped_ctx(uint8_t player, uint8_t camera) : mSaved(g_pc_ss_ctx), mSavedOwner(s_curOwner) {
+    s_scopeDepth++;
+    s_curOwner = player;
+    const pc_ss_ctx_t to = {player, camera};
+    if (to.player != g_pc_ss_ctx.player || to.camera != g_pc_ss_ctx.camera) {
+        switchTo(to);
+    }
+}
+
+pc_ss_scoped_ctx::~pc_ss_scoped_ctx() {
+    leaveScope(mSaved, mSavedOwner);
+}
