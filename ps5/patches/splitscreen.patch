+    s_suspended = false;
+}
+
+void pc_ss_on_scene_play_execute() {
+    if (!s_sceneActive) {
+        return;
+    }
+    readSetting();
+
+    if (++s_pruneTimer >= kPruneInterval) {
+        s_pruneTimer = 0;
+        prune();
+    }
+    s_p2CameraReady = procCreated(s_p2CameraId);
+
+    fopAc_ac_c* p1 = play().getPlayerPhysical(0);
+    const bool want = s_enabled && p1 != nullptr && !fpcM_IsCreating(fopAcM_GetID(p1));
+    const bool linkAlive = procAlive(s_p2LinkId);
+    const bool cameraAlive = procAlive(s_p2CameraId);
+
+    if (!want) {
+        if ((linkAlive || cameraAlive) && !fpcM_IsCreating(s_p2LinkId) && !fpcM_IsCreating(s_p2CameraId)) {
+            despawn();
+        }
+        setLead(0, "split-screen off");
+        return;
+    }
+
+    markPlayer1(p1);
+    const bool busy = worldBusy();
+
+    if (!s_pendingDelete.empty()) {
+        if (++s_pendingDeleteFrames < kPendingDeleteGiveUpFrames) {
+            return;
+        }
+        pc::writef(STDERR_FILENO, "[cos] splitscreen: %zu of Player 2's processes were not deleted after %d frames\n",
+               s_pendingDelete.size(), s_pendingDeleteFrames);
+        s_pendingDelete.clear();
+    }
+
+    if (!linkAlive) {
+        // Gone (or never there): start again once Player 1 is free.
+        setLead(0, "Player 2 gone");
+        if (cameraAlive && procCreated(s_p2CameraId)) {
+            deleteProc(s_p2CameraId);
+            s_p2CameraId = kNoProc;
+            s_p2CameraReady = false;
+        }
+        s_suspended = false;
+        if (s_cooldown > 0) {
+            s_cooldown--;
+            return;
+        }
+        if (!busy && !cameraAlive) {
+            spawn(p1);
+        }
+        return;
+    }
+
+    s_suspended = busy;
+    fopAc_ac_c* p2 = pc_ss_player2();
+    if (s_suspended || p2 == nullptr || fpcM_IsCreating(s_p2LinkId)) {
+        s_separatedFrames = 0;
+        return;
+    }
+
+    // The follower is brought back to the lead: Player 2 is created again next to Player 1;
+    // Player 1 is moved to Player 2.
+    fopAc_ac_c* lead = s_lead == 0 ? p1 : p2;
+    fopAc_ac_c* follower = s_lead == 0 ? p2 : p1;
+    const f32 dist = (follower->current.pos - lead->current.pos).abs();
+    const bool sailing = riding(0) || riding(1);
+    const f32 leash = sailing ? kSailingLeashDistance : kLeashDistance;
+    const f32 hardLeash = sailing ? kSailingHardLeashDistance : kHardLeashDistance;
+    // On the sea the rooms are the islands: being in another one is no reason to come back.
+    const bool apart = dist > leash || (!sailing && fopAcM_GetRoomNo(follower) != fopAcM_GetRoomNo(lead));
+    s_separatedFrames = apart ? s_separatedFrames + 1 : 0;
+    // Player 1 is not moved off their boat (Player 2 is created again, on foot or swimming).
+    const bool separated = (dist > hardLeash || s_separatedFrames > kSeparatedFramesLimit) &&
+                           !(s_lead == 1 && riding(0));
+    if (s_lead == 0 && (s_respawnRequested || separated)) {
+        pc::writef(STDERR_FILENO, "[cos] splitscreen: bringing Player 2 back to Player 1 (distance %.0f, requested %d)\n",
+               dist, s_respawnRequested ? 1 : 0);
+        despawn();
+        s_cooldown = 2;
+        return;
+    }
+    if (s_lead == 1 && (s_bringPlayer1Requested || separated)) {
+        pc::writef(STDERR_FILENO, "[cos] splitscreen: bringing Player 1 to Player 2 (distance %.0f, requested %d)\n", dist,
+               s_bringPlayer1Requested ? 1 : 0);
+        bringPlayer1ToLead(p1, p2);
+        s_separatedFrames = 0;
+    }
+    s_respawnRequested = false;
+    s_bringPlayer1Requested = false;
+
+    updatePlayer2Ship();
+
+    if (s_p2Attention != nullptr && procCreated(s_p2CameraId)) {
+        pc_ss_scoped_ctx ctx(1, 1);
+        if (s_p2Attention->Owner() != NULL) {
+            s_p2Attention->Run(-1);
+        } else {
+            s_p2Attention->Init(dComIfGp_getPlayer(0), 0);
+        }
+    }
+}
