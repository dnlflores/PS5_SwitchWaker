+// The view of a camera as the draws and culling read it: what the camera's view_setup and draw
+// set when it is the one drawn.
+void publishView(int physicalCamera) {
+    auto* cam = reinterpret_cast<camera_process_class*>(play().getCameraPhysical(physicalCamera));
+    if (cam == nullptr) {
+        return;
+    }
+    view_class* view = &cam->view;
+    dDlst_window_c* window = play().getWindow(play().mCameraInfo[physicalCamera].mDlstWindowIdx);
+    j3dSys.setViewMtx(view->mViewMtx);
+    dComIfGd_setWindow(window);
+    dComIfGd_setViewport(window->getViewPort());
+    dComIfGd_setView(view);
+    f32 far;
+    if (dComIfGp_getScopeMesgStatus() != fopMsgStts_MSG_UNK0_e) {
+        far = view->mFar;
+    } else {
+        far = dStage_stagInfo_GetCullPoint(dComIfGp_getStageStagInfo());
+    }
+    mDoLib_clipper::setup(view->mFovy, view->mAspect, view->mNear, far);
+}
+
+bool drawsInExtraView(const base_process_class* proc) {
+    // The 3D world: actors and the sky and weather; not the cameras (their draw sets the view,
+    // the listener and the minimap) or the HUD and messages.
+    return proc != nullptr && !isCameraProc(proc) &&
+           (fopAc_IsActor((void*)proc) || proc->mProcName == fpcNm_KANKYO_e);
+}
