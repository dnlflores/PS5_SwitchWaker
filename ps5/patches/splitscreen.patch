+void pc_ss_redraw_scene_for_window() {
+    dDlst_list_c& dl = g_dComIfG_gameInfo.drawlist;
+    const dDlst_list_c::Cursors2D cursors = dl.save2DCursors();
+    dl.reset3D();
+
+    publishView(1);
+
+    s_extraPass = true;
+    for (create_tag_class* i = fopDwIt_Begin(); i != NULL; i = fopDwIt_Next(i)) {
+        base_process_class* proc = static_cast<base_process_class*>(i->mpTagData);
+        if (drawsInExtraView(proc)) {
+            fpcM_Draw(proc);
+        }
+    }
+    if (!dMenu_flag()) {
+        dComIfGp_particle_drawModelParticle();
+        dComIfGp_drawMagma();
+        dComIfGp_drawGrass();
+        dComIfGp_drawTree();
+        dComIfGp_drawWood();
+        dComIfGp_drawFlower();
+        {
+            pc_ss_scoped_ctx p1(0, g_pc_ss_ctx.camera);
+            dComIfGp_getAttention().Draw();
+        }
+        pc_ss_on_scene_play_draw();
+    }
+    s_extraPass = false;
+
+    dl.restore2DCursors(cursors);
+}
